# Reservation & Capacity Service Environment Variables

# Application
APP_NAME=FEC Reservation & Capacity Service
VERSION=0.1.0
ENV=development
DEBUG=true
PORT=8012

# Database
DATABASE_URL=postgresql+asyncpg://postgres:ypur-password@localhost:5432/reservation_capacity_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/7

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT (must match auth service)
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Service URLs (for inter-service communication)
AUTH_SERVICE_URL=http://localhost:8000
NOTIFICATION_SERVICE_URL=http://localhost:8001
VENUE_SERVICE_URL=http://localhost:8002
CUSTOMER_SERVICE_URL=http://localhost:8004
RESTAURANT_SERVICE_URL=http://localhost:8009

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8080"]
