# =============================================================================
# Membership Service Environment Configuration
# =============================================================================

# Service Configuration
SERVICE_NAME=membership-service
ENVIRONMENT=development
DEBUG=true
PORT=8005
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/membership

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-production-secret-key
JWT_ALGORITHM=HS256

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Payment Gateway Service
PAYMENT_GATEWAY_URL=http://localhost:8004

# Customer Service
CUSTOMER_SERVICE_URL=http://localhost:8002

# Loyalty Program Defaults
DEFAULT_POINTS_PER_DOLLAR=1.0
DEFAULT_POINTS_EXPIRY_DAYS=365
MAX_REFERRAL_BONUS_POINTS=500

# Subscription Settings
DUNNING_MAX_ATTEMPTS=4
DUNNING_RETRY_DAYS=[3, 5, 7, 10]
GRACE_PERIOD_DAYS=7
MAX_PAUSE_DAYS=90

# Notification Settings
NOTIFY_DAYS_BEFORE_RENEWAL=[7, 3, 1]
NOTIFY_ON_POINTS_EARNED=true
NOTIFY_ON_TIER_CHANGE=true
