# Notification Service Configuration
# Copy to .env and customize values

# Environment
NOTIFICATION_ENV=local
NOTIFICATION_DEBUG=true

# Database
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification_db

# Redis
NOTIFICATION_REDIS_URL=redis://localhost:6379/1

# RabbitMQ (optional)
NOTIFICATION_RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Email - SendGrid
# NOTIFICATION_SENDGRID_API_KEY=your_sendgrid_api_key
NOTIFICATION_DEFAULT_FROM_EMAIL=noreply@fec-saas.com
NOTIFICATION_DEFAULT_FROM_NAME=FEC SaaS

# SMS - Twilio
# NOTIFICATION_TWILIO_ACCOUNT_SID=your_twilio_sid
# NOTIFICATION_TWILIO_AUTH_TOKEN=your_twilio_token
# NOTIFICATION_TWILIO_FROM_NUMBER=+1234567890

# Push Notifications - Firebase
# NOTIFICATION_FIREBASE_PROJECT_ID=your_firebase_project
# NOTIFICATION_FIREBASE_CREDENTIALS_PATH=/path/to/firebase-credentials.json

# Queue Settings
NOTIFICATION_MAX_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=60
NOTIFICATION_BATCH_SIZE=100

# Rate Limits
NOTIFICATION_EMAIL_RATE_LIMIT_PER_MINUTE=100
NOTIFICATION_SMS_RATE_LIMIT_PER_MINUTE=50

# CORS
NOTIFICATION_BACKEND_CORS_ORIGINS_STR=http://localhost:3000,http://localhost:8080
