# =============================================================================
# Customer Service Environment Configuration
# =============================================================================

# Application
APP_NAME=FEC Customer Service
VERSION=0.1.0
ENV=development
DEBUG=true
PORT=8004

# Database
DATABASE_URL=postgresql+asyncpg://postgres:gyenoch@localhost:5432/customer_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_ECHO=false

# Redis (DB 4 for Customer Service - Auth=0, Notification=1, Venue=2, Party=3)
REDIS_URL=redis://localhost:6379/4
CACHE_TTL_SECONDS=300

# JWT (must match Auth Service)
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Service URLs
AUTH_SERVICE_URL=http://localhost:8000
VENUE_SERVICE_URL=http://localhost:8002
NOTIFICATION_SERVICE_URL=http://localhost:8001
PARTY_SERVICE_URL=http://localhost:8003
PAYMENT_SERVICE_URL=http://localhost:8006

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8080"]

# Customer Configuration
DEFAULT_SEGMENT_EXPIRY_DAYS=30
CHURN_RISK_THRESHOLD_DAYS=60
VIP_THRESHOLD_VISITS=10
VIP_THRESHOLD_SPEND=1000.00
PREMIUM_THRESHOLD_VISITS=5
PREMIUM_THRESHOLD_SPEND=500.00

# Analytics Configuration
LTV_CALCULATION_MONTHS=12
VISIT_FREQUENCY_WINDOW_DAYS=90
CHURN_PREDICTION_WINDOW_DAYS=30

# Feature Flags
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_AUDIT_LOGGING=true
ENABLE_EVENT_PUBLISHING=true
ENABLE_CHURN_PREDICTION=true
ENABLE_AUTO_SEGMENTATION=true
ENABLE_VISIT_PREDICTION=true
