# =============================================================================
# Payment Gateway Service - Environment Configuration
# =============================================================================

# Application
APP_NAME=payment-gateway-service
APP_VERSION=0.1.0
ENV=development
DEBUG=true
PORT=8010

# Database
DATABASE_URL=postgresql+asyncpg://postgres:gyenoch@localhost:5432/payment_gateway
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/5

# JWT (shared with auth service)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# Encryption for sensitive data
ENCRYPTION_KEY=

# Payment Processors
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox

# Fraud Detection
FRAUD_SCORE_THRESHOLD=70
FRAUD_AUTO_BLOCK_THRESHOLD=90
VELOCITY_CHECK_WINDOW_MINUTES=60
MAX_TRANSACTIONS_PER_WINDOW=10

# PCI Compliance
PCI_COMPLIANCE_LEVEL=SAQ-A
TOKENIZATION_ENABLED=true

# Service URLs
AUTH_SERVICE_URL=http://localhost:8000
NOTIFICATION_SERVICE_URL=http://localhost:8001
CUSTOMER_SERVICE_URL=http://localhost:8005

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
