# =============================================================================
# Auth Service Environment Variables
# =============================================================================
# Copy this file to .env and update values for your environment

# -----------------------------------------------------------------------------
# Environment (local, development, staging, production)
# -----------------------------------------------------------------------------
AUTH_ENV=local
AUTH_DEBUG=true

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# Change this in production!
AUTH_SECRET_KEY=KVjSuk2TOkr5ZBu7QXDoYMJseFKeoPQR_kY_QA9HWj8
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_JWT_ALGORITHM=HS256

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# AUTH_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db
AUTH_DATABASE_URL=postgresql://postgres:gyenoch@localhost:5432/auth_db

# -----------------------------------------------------------------------------
# Redis (Optional - for session storage and token blacklist)
# -----------------------------------------------------------------------------
AUTH_REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# CORS (comma-separated origins)
# -----------------------------------------------------------------------------
AUTH_BACKEND_CORS_ORIGINS_STR=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Email (Optional - for sending verification emails)
# -----------------------------------------------------------------------------
AUTH_DEFAULT_FROM_EMAIL=noreply@example.com

# -----------------------------------------------------------------------------
# Social Auth (Optional - OAuth providers)
# -----------------------------------------------------------------------------
# Google OAuth
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Facebook OAuth
AUTH_FACEBOOK_APP_ID=
AUTH_FACEBOOK_APP_SECRET=

# Apple Sign In
AUTH_APPLE_CLIENT_ID=
AUTH_APPLE_TEAM_ID=

# -----------------------------------------------------------------------------
# Development Command
# -----------------------------------------------------------------------------
# poetry run uvicorn app.main:app --reload --port 8000

 # Poetry (local)
#   cd services/auth
#   poetry lock
#   poetry install
#   poetry run alembic upgrade head
#   poetry run uvicorn app.main:app --reload 

#   # Docker Compose
#   docker-compose up -d --build
#   docker-compose exec auth alembic upgrade head
