{
  "name": "@fec-saas/iot-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "SDK for IoT device communication - wristbands, sensors, beacons, displays",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./wristband": "./src/wristband.ts",
    "./beacon": "./src/beacon.ts",
    "./sensor": "./src/sensor.ts",
    "./mqtt": "./src/mqtt.ts",
    "./websocket": "./src/websocket.ts"
  },
  "scripts": {
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fec-saas/types": "workspace:*",
    "mqtt": "^5.3.4",
    "socket.io-client": "^4.7.4",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.7",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
